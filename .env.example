# Copy to .env and adjust if needed (minimum 32 characters for the token).
TALKING_PAGE_TOKEN=talking-page-local-dev-token-32chars-min

# Optional custom voice (local path on the host, or in-container path when using Docker mounts)
# TALKING_PAGE_VOICE_SAMPLE=

# Paralinguistic tagger (Chatterbox inline tags). Train a model before enabling in production.
# TALKING_PAGE_TAGGER_ENABLED=1
# TALKING_PAGE_TAG_CONFIDENCE_THRESHOLD=0.65
# TALKING_PAGE_TAGGER_MODEL_PATH=server/models/paralinguistic_tagger.pt
